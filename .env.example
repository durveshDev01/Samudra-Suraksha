# Samudra Suraksha — Environment Variable Template
# Copy this file to backend/.env and fill in real values.
# ⚠️ backend/.env must NEVER be committed to Git.

# --- Gopher API (Twitter Data) ---
GOPHER_API_URL=https://data.gopher-ai.com/api/v1/search/live/twitter
GOPHER_AUTH_TOKEN=your_gopher_auth_token_here

# --- Google Gemini AI ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# --- Firebase FCM ---
FIREBASE_SERVICE_ACCOUNT_PATH=backend/firebase_service_account.json
FCM_DEFAULT_TOPIC=gov_alerts

# --- Flask ---
FLASK_ENV=development
FLASK_SECRET_KEY=change-me-to-a-long-random-string
